# Happy Bee Landscaping - Environment Variables
# Copy this file to .env.local and fill in your values

# Contact Information (displayed on website)
NEXT_PUBLIC_CONTACT_EMAIL=info@happybeelandscapes.ca
NEXT_PUBLIC_CONTACT_PHONE=(604) 674-6785

# Web3Forms Configuration
# The quote form uses Web3Forms for submissions.
# A default access key is provided in site-config.ts, but you can override it here.
# Get your own key from https://web3forms.com
# NEXT_PUBLIC_WEB3FORMS_KEY=e3eb3787-266b-4709-8a0e-99f7027be0f2
