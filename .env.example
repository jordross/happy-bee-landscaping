# Happy Bee Landscaping - Environment Variables
# Copy this file to .env.local and fill in your values

# Contact Information (displayed on website)
NEXT_PUBLIC_CONTACT_EMAIL=info@happybeelandscapes.ca
NEXT_PUBLIC_CONTACT_PHONE=(604) 674-6785

# Form Submission Endpoint
# Option 1: Formspree (recommended) - Get your endpoint from https://formspree.io
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Option 2: Resend API - Uncomment if using Resend
# RESEND_API_KEY=re_your_api_key_here

# Option 3: Leave blank to use mailto fallback (opens email client)
# NEXT_PUBLIC_FORM_ENDPOINT=

# If no endpoint is set, form will open user's email client with pre-filled information
